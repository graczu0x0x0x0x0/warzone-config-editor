# Game settings files use LF and must stay byte-identical (round-trip test fixtures).
examples/** -text
*.txt0 -text
*.txt1 -text
*.m binary

# Source and docs: normalize to LF in the repo.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
